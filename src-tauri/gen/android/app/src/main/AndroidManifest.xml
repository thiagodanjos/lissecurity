<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
      Sem permissão de internet: o LisSecurity não fala com nenhum servidor. A interface é
      servida pela própria app (http://tauri.localhost, intercetado localmente). A versão de
      desenvolvimento (src/debug) volta a pedir a permissão para o servidor do Vite.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.lissecurity"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/extracao_dados"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        tools:targetApi="31">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|density|fontScale"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:excludeFromRecents="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- limpeza agendada da área de transferência (só o sistema, a pedido da app) -->
        <receiver android:name=".LimparAreaTransferencia" android:exported="false" />

        <!-- partilha da cópia cifrada (só a pasta cache/partilha) -->
        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
